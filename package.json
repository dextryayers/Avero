{
  "name": "avero-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "AVERO STUDIO - Open source professional photo editor for Linux and Windows",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "stop": "node -e \"try{require('child_process').execSync('taskkill /F /IM avero-studio.exe',{stdio:'ignore'})}catch(e){}\"",
    "pretauri:build:debug": "npm run stop --silent",
    "tauri:build:debug": "tauri build --debug --no-bundle",
    "pretauri:build:release": "npm run stop --silent",
    "tauri:build:release": "tauri build --bundles nsis,msi || tauri build --bundles nsis,msi",
    "tauri:build:debug:bun": "bun run stop && bunx tauri build --debug --no-bundle",
    "tauri:build:release:bun": "bun run stop && bunx tauri build --bundles nsis,msi || bunx tauri build --bundles nsis,msi",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.16",
    "vitest": "^3.0.0",
    "jsdom": "^25.0.0"
  }
}
