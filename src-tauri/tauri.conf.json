{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSD Studio",
  "version": "0.1.0",
  "identifier": "com.psdstudio.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PSD Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "shortDescription": "Open source professional photo editor",
    "longDescription": "PSD Studio is a free and open source raster photo editor for Linux and Windows with non destructive workflow and offline AI.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": ["https://github.com/psdstudio/psd-studio/releases/latest/download/latest.json"],
      "dialog": false,
      "pubkey": "TODO-REPLACE-WITH-UPDATE-PUBKEY"
    }
  }
}
